{
  "name": "AppCreative vetting exercise (.NET)",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0"
    }
  },
  "containerEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1"
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },
  "postCreateCommand": "pip install --user -r requirements.txt && dotnet build tests/Recommendations.Tests && dotnet build services/Orders && (docker compose pull || true)",
  "forwardPorts": [3000, 8001],
  "portsAttributes": {
    "3000": { "label": "Grafana" },
    "8001": { "label": "Orders app" }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["CANDIDATE.md"]
    },
    "vscode": {
      "extensions": ["ms-dotnettools.csharp"]
    }
  }
}
